{#
  Weyl chamber panel. Included from gate.njk (below the two columns) for
  two-qubit gates that declare `weyl` in their front matter; the drawing itself
  is done by js/weyl.js.
#}
<section class="weyl section" aria-labelledby="weyl-heading">
  <div class="section-head">
    <h2 class="section-title" id="weyl-heading">Weyl chamber</h2>
    <p>Where this gate sits among all two-qubit gates, up to single-qubit rotations before and after.</p>
  </div>
  <div class="weyl-panel">
    <div class="weyl-main">
      <div class="weyl-figure">
        <svg class="weyl-svg" viewBox="0 0 400 320" role="img" tabindex="0"
             aria-label="Position of the {{ title | stripMath }} gate in the Weyl chamber of two-qubit gates. Drag or use the arrow keys to rotate."></svg>
        <button type="button" class="weyl-reset" hidden>reset view</button>
        <div class="weyl-tooltip" role="tooltip" hidden></div>
      </div>
      <ul class="weyl-key" aria-hidden="true">
        <li><svg viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="5" class="weyl-key-current"/></svg>this gate</li>
        <li><svg viewBox="0 0 14 14" width="14" height="14"><circle cx="7" cy="7" r="4" class="weyl-key-landmark"/></svg>other gates</li>
        <li><svg viewBox="0 0 14 14" width="14" height="14"><rect x="1.5" y="1.5" width="11" height="11" class="weyl-key-pe"/></svg>perfect entanglers</li>
      </ul>
    </div>
    <div class="weyl-side">
      <div class="weyl-controls"></div>
      <div class="weyl-readout" aria-live="polite">
        <p class="weyl-facts"><strong>Coordinates:</strong> <span class="weyl-coords"></span></p>
        <p class="weyl-status">
          <span class="chip weyl-badge" data-state="local" hidden>not entangling</span>
          <span class="chip weyl-badge" data-state="entangling" hidden>entangling</span>
          <span class="chip weyl-badge weyl-badge-pe" data-state="perfect" hidden>perfect entangler</span>
          <span class="weyl-equiv" hidden></span>
        </p>
      </div>
      <p class="weyl-note">
        $(a, b, c)$ means the gate equals $e^{i(a\,XX + b\,YY + c\,ZZ)}$ up to single-qubit gates,
        reduced to the chamber $\pi/4 \ge a \ge b \ge |c|$ (the convention of the
        <a href="{{ '/gates/can/' | url }}">canonical gate</a>, Qiskit and Cirq).
        The $a = \pi/4$ face is a mirror: $(\pi/4, b, c)$ and $(\pi/4, b, -c)$ are the same gate.
        Drag the figure to rotate it, double-click to reset.
      </p>
    </div>
  </div>
  <script type="application/json" class="weyl-data">{{ collections.gates | weylData(page.fileSlug) | safe }}</script>
  <script defer src="{{ '/js/weyl.js' | url }}"></script>
</section>
