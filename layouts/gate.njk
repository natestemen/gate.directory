{% extends "base.njk" %}

{% block content %}
{% set fam = periodic_layout | gateFamily(page.fileSlug) %}
{% set quirkHref = quirk | quirkUrl(page.fileSlug, symbol, params) %}
{% set githubPath = page.inputPath | replace('./', '') %}
{% set controlledVariants = [] %}
{% for g in collections.gates %}
  {% if g.data.controlled == page.fileSlug %}
    {% set controlledVariants = (controlledVariants.push(g), controlledVariants) %}
  {% endif %}
{% endfor %}

<article class="gate">
  <header class="gate-masthead">
    <div class="symbol-card"{% if fam %} style="--fam: {{ fam.color }}"{% endif %}>${{ symbol }}$</div>
    <div class="gate-masthead-text">
      <p class="caption gate-kicker">
        {% if fam %}<span>{{ fam.label }}</span><span aria-hidden="true">·</span>{% endif %}
        <span>{{ arity }} qubit{% if arity != 1 %}s{% endif %}</span>
        {% if dimension and dimension != 2 %}<span aria-hidden="true">·</span><span>dimension ${{ dimension }}$</span>{% endif %}
        {% if parameters %}<span aria-hidden="true">·</span><span>{{ parameters }} parameter{% if parameters != 1 %}s{% endif %}</span>{% endif %}
      </p>
      <h2 class="gate-title">{{ title }}</h2>
      <div class="gate-lede">{{ description | markdown | safe }}</div>
      <div class="gate-actions">
        {% if quirkHref %}
          <a class="button" href="{{ quirkHref }}" target="_blank" rel="noopener">Open in Quirk ↗</a>
          {% set quirkNote = quirk | quirkNote(params) %}{% if quirkNote %}<span class="quirk-note">with ${{ quirkNote }}$</span>{% endif %}
        {% endif %}
        {% for prop in properties %}<span class="chip">{{ prop }}</span>{% endfor %}
      </div>
    </div>
  </header>

  <div class="gate-body">
    <div class="gate-main">
      {{ content | safe }}
    </div>

    <aside class="gate-aside">
      {% if notations %}
        <section>
          <h3 class="caption">Also written</h3>
          <ul class="notation-list">
            {% for n in notations %}<li>${{ n }}$</li>{% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if controlled or controlledVariants.length %}
        <section>
          <h3 class="caption">Related</h3>
          <ul class="aside-list">
            {% if controlled %}
              {% set baseGate = collections.gates | gateBySlug(controlled) %}
              {% if baseGate %}<li>Controlled version of <a href="{{ baseGate.url | url }}">{{ baseGate.data.title }}</a></li>{% endif %}
            {% endif %}
            {% for g in controlledVariants %}
              <li>Controlled variant: <a href="{{ g.url | url }}">{{ g.data.title }}</a></li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if groups %}
        <section>
          <h3 class="caption">Groups</h3>
          <ul class="chip-list">
            {% for group in groups %}<li><a class="chip" href="{{ ('/groups/' + group + '/') | url }}">{{ group }}</a></li>{% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if citation %}
        <section>
          <h3 class="caption">Reference</h3>
          <p class="gate-citation"><a href="{{ citation.url }}">{{ citation.title or citation.url }}</a>{% if citation.year %} ({{ citation.year }}){% endif %}</p>
        </section>
      {% endif %}

      <section>
        <h3 class="caption">Data</h3>
        <ul class="aside-list">
          <li><a href="{{ ('/api/gates/' + page.fileSlug + '.json') | url }}">This gate as JSON</a></li>
          <li><a href="https://github.com/natestemen/gate.directory/tree/main/{{ githubPath }}" target="_blank" rel="noopener">Edit this page on GitHub</a></li>
        </ul>
      </section>
    </aside>
  </div>

  {% if matrix %}{% include "unitary.njk" %}{% endif %}

  {% if weyl %}{% include "weyl.njk" %}{% endif %}

  {% if sdks %}
    <section class="section" id="sdk-support">
      <div class="section-head">
        <h2 class="section-title">SDK support</h2>
        <p>How to call this gate in each framework. Hover a ⓘ for a note; the <a href="{{ '/sdks/' | url }}">support matrix</a> compares every gate at once.</p>
      </div>
      <div class="sdk-table-wrap">
        <table class="sdk-table">
          <thead>
            <tr><th>SDK</th><th>Name</th></tr>
          </thead>
          <tbody>
            {% for sdk in sdk_list %}
              {% set entry = sdks[sdk.key] %}
              <tr>
                <td>{{ sdk.label }}</td>
                {% if entry and entry.name %}
                  <td><a href="{{ entry.url }}"><code>{{ entry.name }}</code></a>{% if entry.note %} <span class="sdk-note" data-note="{{ entry.note }}">ⓘ</span>{% endif %}</td>
                {% else %}
                  <td class="sdk-unavailable">—{% if entry.note %} <span class="sdk-note" data-note="{{ entry.note }}">ⓘ</span>{% endif %}</td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  <p class="gate-foot"><a href="{{ '/' | url }}">← All gates</a></p>
</article>
{% endblock %}
