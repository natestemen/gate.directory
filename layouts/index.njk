{% extends "base.njk" %}

{% from "gate-card.njk" import gateTile %}

{# One card per layout cell. `cell` is a slug, a {slug, fams} override, a {ghost, name} placeholder or null. #}
{% macro gateCard(cell, rowFams) %}
  {% if cell === null %}
    <div class="gate-card-empty"></div>
  {% elif cell.ghost %}
    <a class="gate-card gate-card-ghost" href="https://github.com/natestemen/gate.directory/issues/new"
       title="Predicted by the table but undocumented — open an issue">
      <span class="gate-card-symbol">${{ cell.ghost }}$</span>
      <span class="gate-card-name">{{ cell.name }}</span>
    </a>
  {% else %}
    {% set slug = cell.slug if cell.slug else cell %}
    {% set fams = cell.fams if cell.fams else rowFams %}
    {% set gate = collections.gates | gateBySlug(slug) %}
    {% if gate %}
      {{ gateTile(gate, periodic_layout.families[fams[0]].color) }}
    {% else %}
      <div class="gate-card-empty" title="unknown: {{ slug }}"></div>
    {% endif %}
  {% endif %}
{% endmacro %}

{# Consecutive layout rows with the same families share one caption. #}
{% macro familyBands(rows) %}
  {% set bands = [] %}
  {% for row in rows %}
    {% set key = row.fams | join('+') %}
    {% if bands.length and bands[bands.length - 1].key == key %}
      {% set _ = bands[bands.length - 1].rows.push(row) %}
    {% else %}
      {% set _ = bands.push({ key: key, fams: row.fams, rows: [row] }) %}
    {% endif %}
  {% endfor %}
  {% for band in bands %}
    <section class="family-band" style="--fam: {{ periodic_layout.families[band.fams[0]].color }}">
      <h3 class="family-caption">
        {% for f in band.fams %}<span class="family-caption-item" style="--fam: {{ periodic_layout.families[f].color }}">{{ periodic_layout.families[f].label }}</span>{% endfor %}
      </h3>
      {% for row in band.rows %}
        <div class="family-grid">
          {% for cell in row.cells %}{{ gateCard(cell, row.fams) }}{% endfor %}
        </div>
      {% endfor %}
    </section>
  {% endfor %}
{% endmacro %}

{% block content %}
{% set gateCount = collections.gates | length %}
{% set groupCount = collections.groups | length %}
{% set sdkCount = sdk_list | length %}

<section class="home-hero">
  <h2 class="home-title">A field guide to quantum gates.</h2>
  <p class="home-lede">
    Definitions, matrices, properties and SDK names for the gates of quantum computing,
    from the Paulis to hardware natives.
  </p>
  <div class="gate-search">
    <input type="search" id="gate-search-input" placeholder="Search by name, alias or SDK name — CU1, XXPlusYY, fredkin…" autocomplete="off" aria-label="Search gates" />
    <ul id="gate-search-results" hidden></ul>
  </div>
  <p class="home-stats">
    <a href="#gates">{{ gateCount }} gates</a>
    <span aria-hidden="true">·</span>
    <a href="#groups">{{ groupCount }} groups</a>
    <span aria-hidden="true">·</span>
    <a href="{{ '/sdks/' | url }}">{{ sdkCount }} SDKs</a>
  </p>
</section>

<section class="section" id="gates">
  <div class="section-head">
    <h2 class="section-title">Gates by family</h2>
    <p>Grouped by family. Within a row, the first three columns are the $X$, $Y$ and $Z$ flavours of a gate. The small number in each card is the qubit count, and the one on the right is the number of parameters.</p>
  </div>
  <div class="family-table">
    <div class="family-colheads" aria-hidden="true">
      {% for c in periodic_layout.columns %}<span>{{ c }}</span>{% endfor %}
    </div>
    {{ familyBands(periodic_layout.rows) }}
    <div class="family-divider" role="separator"></div>
    {{ familyBands(periodic_layout.pullout) }}
  </div>
</section>

<section class="section" id="groups">
  <div class="section-head">
    <h2 class="section-title">Groups</h2>
    <p>Subgroups of the unitary group $\mathsf{U}(n)$ worth knowing by name. The map shows how they nest and overlap, with one example gate per region. Click a region or a chip to read about the group.</p>
  </div>

  {% set current = null %}
  {% include "group-map.njk" %}

  <ul class="chip-list">
    {% for group in collections.groups | sort(false, false, 'data.title') %}
      {% set n = 0 %}
      {% for g in collections.gates %}
        {% if group.data.all_gates or (g.data.groups and (group.fileSlug in g.data.groups)) %}{% set n = n + 1 %}{% endif %}
      {% endfor %}
      <li><a class="chip" href="{{ group.url | url }}">{{ group.data.title | replace(' Group', '') | lower }}<span class="chip-count">{{ n }}</span></a></li>
    {% endfor %}
  </ul>
</section>

<section class="section" id="sdks">
  <div class="section-head">
    <h2 class="section-title">SDK support</h2>
    <p>Each gate page names the gate in every framework that has it. The <a href="{{ '/sdks/' | url }}">support matrix</a> shows all gates against all frameworks at once.</p>
  </div>
  <ul class="chip-list">
    {% for sdk in sdk_list %}<li><a class="chip" href="{{ sdk.url }}">{{ sdk.label }}</a></li>{% endfor %}
  </ul>
</section>

<section class="section home-contribute">
  <p>Missing a gate, or spotted a mistake? <a href="https://github.com/natestemen/gate.directory/issues/new">Open an issue</a> or edit the page on GitHub; every page links to its source.</p>
</section>

<script>
  (function () {
    const input = document.getElementById("gate-search-input");
    const list = document.getElementById("gate-search-results");
    if (!input || !list) return;

    let indexPromise = null;
    const loadIndex = () => {
      if (!indexPromise) indexPromise = fetch("{{ '/search-index.json' | url }}").then((r) => r.json());
      return indexPromise;
    };
    input.addEventListener("focus", loadIndex, { once: true });

    input.addEventListener("input", async () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        list.hidden = true;
        list.innerHTML = "";
        return;
      }
      const gates = await loadIndex();
      const results = [];
      for (const g of gates) {
        let best = null;
        const consider = (text, rank, label) => {
          if (!text) return;
          const t = text.toLowerCase();
          if (t === q) rank -= 0.5;
          else if (t.startsWith(q)) rank += 0;
          else if (t.includes(q)) rank += 0.25;
          else return;
          if (!best || rank < best.rank) best = { rank, label };
        };
        consider(g.title, 1, null);
        for (const a of g.aliases) consider(a, 1, null);
        for (const s of g.sdks) consider(s.name, 2, s.name);
        for (const n of g.notations) consider(n.replace(/\\/g, ""), 3, null);
        consider(g.description, 4, null);
        if (best) results.push({ gate: g, rank: best.rank, label: best.label });
      }
      results.sort((a, b) => a.rank - b.rank || a.gate.title.localeCompare(b.gate.title));

      list.innerHTML = "";
      for (const r of results.slice(0, 10)) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = r.gate.url;
        a.textContent = r.gate.title;
        li.appendChild(a);
        if (r.label) {
          const match = document.createElement("span");
          match.className = "search-match";
          match.textContent = r.label;
          li.appendChild(match);
        }
        list.appendChild(li);
      }
      if (!results.length) {
        const li = document.createElement("li");
        li.className = "search-empty";
        li.textContent = "No gates found";
        list.appendChild(li);
      }
      list.hidden = false;
    });

    document.addEventListener("click", (event) => {
      if (!event.target.closest(".gate-search")) list.hidden = true;
    });
  })();
</script>
{% endblock %}
