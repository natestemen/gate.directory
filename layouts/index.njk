{% extends "base.njk" %}

{% macro cellFor(cell, rowFams, rowIndex, colIndex) %}
  {% if cell === null %}
    <div class="pt-empty"></div>
  {% elif cell.ghost %}
    <a class="pt-cell pt-ghost" data-row="{{ rowIndex }}" data-col="{{ colIndex }}" data-fams="{{ rowFams | join(' ') }}"
       href="https://github.com/natestemen/gate.directory/issues/new"
       title="Predicted by the table, but undocumented — open an issue!">
      <div class="pt-symbol">${{ cell.ghost }}$</div>
      <div class="pt-name">{{ cell.name }}</div>
    </a>
  {% else %}
    {% if cell.slug %}
      {% set slug = cell.slug %}
      {% set fams = cell.fams %}
    {% else %}
      {% set slug = cell %}
      {% set fams = rowFams %}
    {% endif %}
    {% set gate = collections.gates | gateBySlug(slug) %}
    {% if gate %}
      {% set c1 = periodic_layout.families[fams[0]].color %}
      <a class="pt-cell" data-row="{{ rowIndex }}" data-col="{{ colIndex }}" data-fams="{{ fams | join(' ') }}"
         href="{{ gate.url | url }}"
         {% if fams.length > 1 %}
           {% set stops = [] %}
           {% for f in fams %}
             {% set stops = (stops.push("color-mix(in srgb, " + periodic_layout.families[f].color + " 25%, white)"), stops) %}
           {% endfor %}
           style="background: linear-gradient(135deg, {{ stops | join(', ') }});"
         {% else %}
           style="background: color-mix(in srgb, {{ c1 }} 24%, white);"
         {% endif %}>
        <span class="pt-arity">{{ gate.data.arity }}</span>
        {% if gate.data.parameters %}<span class="pt-params">{{ gate.data.parameters }}</span>{% endif %}
        <div class="pt-symbol">${{ gate.data.symbol | safe }}$</div>
        <div class="pt-name">{{ gate.data.title | stripMath }}</div>
      </a>
    {% else %}
      <div class="pt-empty" title="unknown: {{ slug }}"></div>
    {% endif %}
  {% endif %}
{% endmacro %}

{% macro gridFor(rows, id) %}
  <div class="pt-wrap" id="{{ id }}">
    <svg class="pt-outlines" aria-hidden="true"></svg>
    <div class="pt-grid2">
      {% for row in rows %}
        {% set rowIndex = loop.index0 %}
        {% for cell in row.cells %}
          {{ cellFor(cell, row.fams, rowIndex, loop.index0) }}
        {% endfor %}
        {% if row.cells.length < 8 %}
          {% for i in range(row.cells.length, 8) %}<div class="pt-empty"></div>{% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endmacro %}

{% block content %}
<p>
  Quantum gates are the fundamental building block of quantum computation.
  This website aims to provide information regarding quantum gates seen in literature, and in practice in building quantum computers.
</p>

<div class="gate-search">
  <input type="search" id="gate-search-input" placeholder="Search gates by name, alias, or SDK name (e.g. CU1, XXPlusYY, fredkin)…" autocomplete="off" aria-label="Search gates" />
  <ul id="gate-search-results" hidden></ul>
</div>

<br/>

<h2>Periodic Table of Gates</h2>
<p class="periodic-explanation">
  Columns 1–3 are the X, Y, and Z axis columns — reading down a column goes flip → root →
  rotation → controlled → coupling. Each cell shows its qubit count (top left) and parameter
  count (top right). Families are drawn as woven regions: gates belonging to several families sit
  where the outlines overlap — hover any gate to light up its families. Qudit and circuit-level
  entries live in the pull-out strip below, and the dashed cell is a gap the table predicts:
  a gate with no page yet.
</p>

<div class="pt-table">
  <div class="pt-headrow">
    {% for i in range(0, 8) %}
      <div class="pt-colhead">{{ periodic_layout.columns[i] }}</div>
    {% endfor %}
  </div>

  {{ gridFor(periodic_layout.rows, "pt-main") }}

  <div class="pt-pullout">
    {{ gridFor(periodic_layout.pullout, "pt-pullout-grid") }}
  </div>
</div>

<br/>

<h2>Groups</h2>
