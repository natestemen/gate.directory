<p class="venn-caption">
  The small grey labels mark one example gate per intersection.
</p>

<br/>

<h2>SDK Support</h2>
<p>
Wondering which framework implements a gate natively?
The <a href="{{ '/sdks/' | url }}">SDK support matrix</a> shows every gate against Qiskit, PennyLane, Cirq, Q#, PyQuil, Braket, BQSKit, Qibo, pytket, Stim, and OpenQASM, with links into each SDK's documentation.
</p>

<br/>

<p>
Not finding a gate you're interested in?
Open an <a href="https://github.com/natestemen/gate.directory/issues/new">issue</a> and we'll add it!
</p>

<script>
  (function () {
    const input = document.getElementById("gate-search-input");
    const list = document.getElementById("gate-search-results");
    if (!input || !list) {
      return;
    }

    let indexPromise = null;
    const loadIndex = () => {
      if (!indexPromise) {
        indexPromise = fetch("{{ '/search-index.json' | url }}").then((r) => r.json());
      }
      return indexPromise;
    };
    input.addEventListener("focus", loadIndex, { once: true });

    input.addEventListener("input", async () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        list.hidden = true;
        list.innerHTML = "";
        return;
      }

      const gates = await loadIndex();
      const results = [];
      for (const g of gates) {
        let best = null;
        const consider = (text, rank, label) => {
          if (!text) return;
          const t = text.toLowerCase();
          if (t === q) rank -= 0.5;
          else if (t.startsWith(q)) rank += 0;
          else if (t.includes(q)) rank += 0.25;
          else return;
          if (!best || rank < best.rank) best = { rank, label };
        };
        consider(g.title, 1, null);
        for (const a of g.aliases) consider(a, 1, null);
        for (const s of g.sdks) consider(s.name, 2, s.name);
        for (const n of g.notations) consider(n.replace(/\\/g, ""), 3, null);
        consider(g.description, 4, null);
        if (best) results.push({ gate: g, rank: best.rank, label: best.label });
      }
      results.sort((a, b) => a.rank - b.rank || a.gate.title.localeCompare(b.gate.title));

      list.innerHTML = "";
      for (const r of results.slice(0, 10)) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = r.gate.url;
        a.textContent = r.gate.title;
        li.appendChild(a);
        if (r.label) {
          const match = document.createElement("span");
          match.className = "search-match";
          match.textContent = r.label;
          li.appendChild(match);
        }
        list.appendChild(li);
      }
      if (!results.length) {
        const li = document.createElement("li");
        li.className = "search-empty";
        li.textContent = "No gates found";
        list.appendChild(li);
      }
      list.hidden = false;
    });

    document.addEventListener("click", (event) => {
      if (!event.target.closest(".gate-search")) {
        list.hidden = true;
      }
    });
  })();
</script>

<script>
  const PT_FAMILIES = {{ periodic_layout.families | dump | safe }};

  function drawRegions(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const svg = container.querySelector("svg.pt-outlines");
    svg.innerHTML = "";
    container.querySelectorAll(".pt-region-label").forEach((el) => el.remove());

    // cell offsets are grid-relative; the svg overlay is wrap-relative
    const grid = container.querySelector(".pt-grid2");
    const ox = grid.offsetLeft, oy = grid.offsetTop;

    const fams = {};
    for (const cell of container.querySelectorAll("[data-fams]")) {
      const r = +cell.dataset.row;
      const L = cell.offsetLeft + ox, T = cell.offsetTop + oy;
      const R = L + cell.offsetWidth, B = T + cell.offsetHeight;
      for (const f of cell.dataset.fams.split(" ")) {
        const rows = (fams[f] ??= new Map());
        const e = rows.get(r) || { L: 1e9, R: -1e9, T: 1e9, B: -1e9 };
        e.L = Math.min(e.L, L); e.R = Math.max(e.R, R);
        e.T = Math.min(e.T, T); e.B = Math.max(e.B, B);
        rows.set(r, e);
      }
    }

    svg.setAttribute("width", container.scrollWidth);
    svg.setAttribute("height", container.scrollHeight);

    Object.keys(fams).forEach((f) => {
      const meta = PT_FAMILIES[f];
      const rows = [...fams[f].entries()].sort((a, b) => a[0] - b[0]).map((e) => e[1]);
      const inset = meta.inset || 6;
      const n = rows.length;
      const ys = [rows[0].T - inset];
      for (let i = 0; i < n; i++) {
        ys.push(i < n - 1 ? (rows[i].B + rows[i + 1].T) / 2 + (inset - 8) * 0.5 : rows[i].B + inset);
      }
      let d = `M ${rows[0].L - inset} ${ys[0]} L ${rows[0].R + inset} ${ys[0]}`;
      for (let i = 0; i < n; i++) {
        d += ` L ${rows[i].R + inset} ${ys[i + 1]}`;
        if (i < n - 1) d += ` L ${rows[i + 1].R + inset} ${ys[i + 1]}`;
      }
      for (let i = n - 1; i >= 0; i--) {
        d += ` L ${rows[i].L - inset} ${ys[i + 1]}`;
        if (i > 0) {
          d += ` L ${rows[i].L - inset} ${ys[i]}`;
          d += ` L ${rows[i - 1].L - inset} ${ys[i]}`;
        }
      }
      d += " Z";

      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", d);
      path.setAttribute("fill", meta.color);
      path.setAttribute("fill-opacity", "0.05");
      path.setAttribute("stroke", meta.color);
      path.setAttribute("stroke-width", "2.2");
      path.setAttribute("stroke-linejoin", "round");
      path.dataset.fam = f;
      svg.appendChild(path);

      /* pin the label to the topmost row that starts at the region's left
         edge — narrow overlap tongues (e.g. swap reaching up to CSWAP)
         start indented, so they never carry the label */
      const minL = Math.min(...rows.map((r) => r.L));
      const labelRow = rows.find((r) => Math.abs(r.L - minL) < 2) || rows[0];
      const label = document.createElement("span");
      label.className = "pt-region-label";
      label.textContent = meta.label;
      label.style.borderColor = meta.color;
      label.style.color = meta.color;
      label.style.left = labelRow.L - inset + 8 + "px";
      label.style.top = labelRow.T - inset - 8 + "px";
      container.appendChild(label);
    });
  }

  function setupHover() {
    document.querySelectorAll(".pt-wrap").forEach((container) => {
      const cells = container.querySelectorAll(".pt-cell[data-fams]");
      const setActive = (fams) => {
        container.querySelectorAll(".pt-outlines path").forEach((p) =>
          p.classList.toggle("pt-region-active", fams.includes(p.dataset.fam))
        );
        cells.forEach((c) =>
          c.classList.toggle(
            "pt-cell-kin",
            fams.length > 0 && c.dataset.fams.split(" ").some((f) => fams.includes(f))
          )
        );
      };
      cells.forEach((cell) => {
        cell.addEventListener("mouseenter", () => setActive(cell.dataset.fams.split(" ")));
        cell.addEventListener("mouseleave", () => setActive([]));
      });
    });
  }

  function drawAll() {
    drawRegions("pt-main");
    drawRegions("pt-pullout-grid");
  }
  window.addEventListener("load", () => {
    drawAll();
    setTimeout(drawAll, 600); /* re-measure after KaTeX renders */
    setupHover();
  });
  window.addEventListener("resize", drawAll);
</script>
{% endblock %}
