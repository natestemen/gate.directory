{# Euler diagram of the gate groups. Set `current` (a group slug) to highlight one. #}
<svg class="group-map" viewBox="0 0 760 440" role="img" aria-label="Euler diagram of gate group inclusions and overlaps">
  {% set regions = [
    { slug: "unitary", shape: '<rect class="group-shape" x="8" y="8" width="744" height="424" rx="14"/>', label: '<text x="740" y="30" text-anchor="end">unitary</text>' },
    { slug: "clifford", shape: '<rect class="group-shape" x="40" y="40" width="430" height="260" rx="10"/>', label: '<text x="52" y="62">clifford</text>' },
    { slug: "orthogonal", shape: '<rect class="group-shape" x="120" y="150" width="480" height="250" rx="10"/>', label: '<text x="590" y="393" text-anchor="end">orthogonal</text>' },
    { slug: "number-preserving", shape: '<rect class="group-shape" x="300" y="70" width="420" height="290" rx="10"/>', label: '<text x="570" y="350" text-anchor="end">number-preserving</text>' },
    { slug: "diagonal", shape: '<rect class="group-shape" x="310" y="105" width="250" height="141" rx="8"/>', label: '<text x="548" y="118" text-anchor="end">diagonal</text>' },
    { slug: "pauli", shape: '<rect class="group-shape" x="70" y="76" width="260" height="154" rx="8"/>', label: '<text x="78" y="92">pauli</text>' },
    { slug: "permutation", shape: '<rect class="group-shape" x="150" y="210" width="190" height="170" rx="8"/>', label: '<text x="158" y="370">permutation</text>' },
    { slug: "matchgate", shape: '<path class="group-shape" stroke-linejoin="round" d="M 352 78 L 643 78 Q 650 78 650 85 L 650 373 Q 650 380 643 380 L 587 380 Q 580 380 580 373 L 580 297 Q 580 290 573 290 L 432 290 Q 425 290 425 283 L 425 265 Q 425 258 432 258 L 573 258 Q 580 258 580 251 L 580 102 Q 580 95 573 95 L 352 95 Q 345 95 345 88 L 345 85 Q 345 78 352 78 Z"/>', label: '<text x="640" y="175" text-anchor="middle" transform="rotate(-90 640 175)">matchgate</text>' }
  ] %}
  {% for r in regions %}
    <a href="{{ ('/groups/' + r.slug + '/') | url }}"{% if current == r.slug %} class="is-current"{% endif %}>{{ r.shape | safe }}{{ r.label | safe }}</a>
  {% endfor %}
  <g class="group-map-examples" aria-hidden="true">
    <text x="180" y="118">Y</text><text x="222" y="224">X</text><text x="317" y="186">Z</text><text x="317" y="223">I</text>
    <text x="400" y="58">H</text><text x="222" y="280">CNOT</text><text x="320" y="280" text-anchor="middle">SWAP</text>
    <text x="222" y="342">Toffoli</text><text x="320" y="338" text-anchor="middle">CSWAP</text><text x="400" y="128">S</text>
    <text x="510" y="140">T</text><text x="404" y="200">CZ</text><text x="512" y="200">CCZ</text><text x="400" y="90">iSWAP</text>
    <text x="548" y="90">XY</text><text x="447" y="277" text-anchor="middle">fSWAP</text>
    <text x="590" y="235" transform="rotate(-90 590 235)">Givens</text><text x="134" y="330" text-anchor="middle">Ry</text>
    <text x="682" y="200">FSim</text><text x="62" y="412">Rx</text><text x="624" y="374">Rxx</text>
  </g>
</svg>
